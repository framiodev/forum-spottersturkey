{
    "name": "framio/community",
    "description": "Kullanıcı etkileşimi, etiket takibi, arkadaşlık, gelişmiş bildirimler ve topluluk araçları paketi.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "require": {
        "ext-json": "*",
        "flarum/core": "^2.0",
        "flarum/tags": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Framio\\Community\\DefaultGroup\\": "modules/default-group/src/",
            "Framio\\Community\\DefaultUserPreferences\\": "modules/default-user-preferences/src/",
            "Framio\\Community\\FollowTags\\": "modules/follow-tags/src/",
            "Framio\\Community\\IgnoreUsers\\": "modules/ignore-users/src/",
            "Framio\\Community\\LanguageDetection\\": "modules/language-detection/src/",
            "Framio\\Community\\Mailing\\": "modules/mailing/src/",
            "Framio\\Community\\Subscribed\\": "modules/subscribed/src/",
            "Framio\\Community\\UserDirectory\\": "modules/user-directory/src/",
            "HuseyinFiliz\\LanguageDetection\\": "modules/language-detection/src/",
            "Framio\\Community\\Notifications\\": "modules/notifications/src/",
            "forumaker\\Friendship\\": "modules/friendship/src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio Community",
            "category": "feature",
            "icon": {
                "name": "fas fa-users",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
