{
    "name": "framio/blog",
    "description": "Flarum için modern makale, haber ve blog yönetim sistemi.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-rc.8",
        "flarum/tags": "^2.0.0",
        "flarum/lock": "^2.0.0",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Framio\\Blog\\": "src/",
            "FoF\\Blog\\": "src/"
        }
    },
    "replace": {
        "fof/blog": "*",
        "v17development/flarum-blog": "*"
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio Blog",
            "category": "feature",
            "icon": {
                "name": "fas fa-blog",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/sticky",
                "flarum/audit"
            ]
        }
    }
}
