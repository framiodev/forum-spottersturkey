{
    "name": "framio/pwa",
    "description": "Flarum için Progressive Web App (PWA) desteği ve anlık web bildirimleri (Web Push).",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "flarum",
        "pwa",
        "web push"
    ],
    "homepage": "https://dev.framiomedia.com",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0-rc.8",
        "minishlink/web-push": "^10.1 || ^11.0"
    },
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Framio\\PWA\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio PWA",
            "category": "feature",
            "icon": {
                "name": "fas fa-mobile-alt",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
