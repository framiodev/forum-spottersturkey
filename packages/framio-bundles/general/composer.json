{
    "name": "framio/general",
    "description": "Genel site ve görünüm ayarları, Google Fonts, logo yönetimi ve sistem araçları paketi.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "require": {
        "flarum/core": "^2.0.0-beta.1"
    },
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Framio\\General\\": "src/",
            "Stezkoy\\FlarumModularis\\": "modules/modularis/src/",
            "Ramon\\Backup\\": "modules/backup/src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio General",
            "category": "feature",
            "icon": {
                "name": "fas fa-sliders-h",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
