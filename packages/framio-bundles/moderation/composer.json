{
    "name": "framio/moderation",
    "description": "Moderatör notları, kullanıcı uyarıları, yazar değiştirme, tartışma birleştirme ve gönderi taşıma modülleri paketi.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Framio\\Moderation\\ModeratorNotes\\": "modules/moderator-notes/src/",
            "Framio\\Moderation\\ModeratorWarnings\\": "modules/moderator-warnings/src/",
            "Framio\\Moderation\\AuthorChange\\": "modules/author-change/src/",
            "FoF\\MergeDiscussions\\": "modules/merge-discussions/src/",
            "FoF\\MovePosts\\": "modules/move-posts/src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio Moderation",
            "category": "feature",
            "icon": {
                "name": "fas fa-gavel",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
