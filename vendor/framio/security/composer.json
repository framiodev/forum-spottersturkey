{
    "name": "framio/security",
    "description": "Sosyal medya ile giriş (OAuth), sızdırılmış parola denetimi (HaveIBeenPwned) ve reCAPTCHA koruma paketi.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0",
        "google/recaptcha": "^1.3",
        "guzzlehttp/guzzle": "^7.0",
        "league/oauth2-facebook": "^2.2.0",
        "league/oauth2-github": "^3.1.0",
        "league/oauth2-google": "^4.0.1",
        "omines/oauth2-gitlab": "^3.3.0",
        "wohali/oauth2-discord-new": "^1.2.1"
    },
    "autoload": {
        "psr-4": {
            "Framio\\Security\\OAuth\\": "modules/oauth/src/",
            "Framio\\Security\\PwnedPasswords\\": "modules/pwned-passwords/src/",
            "Framio\\Security\\ReCaptcha\\": "modules/recaptcha/src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio Security",
            "category": "feature",
            "icon": {
                "name": "fas fa-shield-alt",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
