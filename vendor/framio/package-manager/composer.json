{
    "name": "framio/package-manager",
    "description": "Framio Konsolide Paket & Modül Yöneticisi — Eklentileri konsolide paketlere dönüştürün, yeni paketler oluşturun veya izole kimlikle kurun.",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Framio-Dev",
            "homepage": "https://dev.framiomedia.com"
        }
    ],
    "require": {
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Framio\\PackageManager\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Framio Paket & Modül Yöneticisi",
            "category": "feature",
            "icon": {
                "name": "fas fa-cubes",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        }
    }
}
